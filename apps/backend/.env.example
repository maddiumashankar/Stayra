# Stayra Backend Environment Configuration

PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL & PostGIS Database
DATABASE_URL=postgresql://stayra_admin:stayra_secret_password@localhost:5432/stayra_dev?schema=public

# Redis Cluster / Cache / Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Token Rotation
JWT_ACCESS_SECRET=stayra_jwt_super_secret_access_key_development_only_change_in_prod_512
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=stayra_jwt_super_secret_refresh_key_development_only_change_in_prod_512
JWT_REFRESH_EXPIRATION=30d

# MinIO / AWS S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET_PUBLIC=stayra-public-photos
S3_BUCKET_PRIVATE=stayra-private-kyc-invoices

# Razorpay / Payment Gateway
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_hmac_secret

# AI Gateway / LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
